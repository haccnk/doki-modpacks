# ==============================================================================
# Doki's Modpacks Hub: Environment Variables Configuration
# Copy this file to .env.local or configure in your Vercel Project Settings
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application URL
# Public URL where the application is hosted
PUBLIC_APP_URL=https://your-modpacks-hub.vercel.app
VITE_APP_URL=https://your-modpacks-hub.vercel.app

# Database & Storage Connection (PostgreSQL / CockroachDB / Supabase)
# Required when connecting external persistent pooling engines
DATABASE_URL="postgresql://postgres:password@localhost:5432/doki_modpacks?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres:password@localhost:5432/doki_modpacks?sslmode=require"

# Authentication & Cryptographic Session Secrets
# Generate using `openssl rand -base64 32`
AUTH_SECRET="your-32-byte-hex-or-base64-random-auth-secret-here"
SESSION_SECRET="your-super-admin-jwt-or-session-secret-here"

# Super Admin Bootstrap Configuration (Optional Overrides)
ADMIN_BOOTSTRAP_USERNAME=doki
ADMIN_BOOTSTRAP_PASSWORD_HASH="" # PBKDF2/SHA-256 hashed password

# External Cloud Storage / Google Drive Mirror Fallbacks
DEFAULT_DOWNLOAD_MIRROR="https://drive.google.com/drive/folders/1aFzU3cR0nRVHCT-gzJSTNoRKEavO-VFk?usp=drive_link"

# Monitoring & Observability (Optional)
VITE_ENABLE_TELEMETRY=true
VITE_API_TIMEOUT_MS=10000
